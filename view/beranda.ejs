<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Data Backup - ExpressJS API</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Courier New', monospace;
            background: #000000;
            color: #ffffff;
            min-height: 100vh;
            padding: 0;
            overflow-x: hidden;
        }

        /* Navbar */
        .navbar {
            background: #ffffff;
            padding: 25px 40px;
            border-bottom: 8px solid #a855f7;
            margin-bottom: 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .navbar h2 {
            color: #000000;
            font-size: 1.8em;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 12px;
            letter-spacing: -1px;
        }

        .navbar h2 i {
            color: #a855f7;
            font-size: 1.2em;
        }

        .navbar-links {
            display: flex;
            gap: 15px;
        }

        .navbar a {
            color: #ffffff;
            background: #000000;
            text-decoration: none;
            padding: 12px 24px;
            border: 4px solid #a855f7;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
            cursor: pointer;
        }

        .navbar a:hover {
            background: #a855f7;
            border-color: #ffffff;
            transform: translate(-4px, -4px);
            box-shadow: 6px 6px 0 #a855f7;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        /* Header */
        .header {
            margin-bottom: 50px;
        }

        .header h1 {
            font-size: 4em;
            font-weight: 900;
            color: #ffffff;
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: -2px;
            line-height: 1;
            text-shadow: 4px 4px 0 #a855f7;
        }

        .header p {
            font-size: 1.3em;
            color: #a855f7;
            font-weight: 700;
            letter-spacing: 1px;
        }

        /* Stats */
        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 25px;
            margin-bottom: 50px;
        }

        .stat-card {
            background: #ffffff;
            color: #000000;
            padding: 35px;
            border: 6px solid #000000;
            text-align: center;
            font-weight: 900;
            transition: all 0.2s;
            cursor: pointer;
        }

        .stat-card:hover {
            border-color: #a855f7;
            transform: translate(-6px, -6px);
            box-shadow: 10px 10px 0 #a855f7;
        }

        .stat-card i {
            font-size: 3em;
            color: #a855f7;
            margin-bottom: 15px;
            display: block;
        }

        .stat-card h3 {
            font-size: 2.5em;
            margin: 15px 0;
            color: #a855f7;
            text-shadow: 2px 2px 0 #000000;
        }

        .stat-card p {
            font-size: 1em;
            color: #000000;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Content */
        .content {
            background: #ffffff;
            padding: 50px;
            border: 8px solid #000000;
            margin-bottom: 50px;
        }

        .content h2 {
            color: #000000;
            margin-bottom: 40px;
            font-size: 2.5em;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 20px;
            text-transform: uppercase;
            letter-spacing: -1px;
            padding-bottom: 25px;
            border-bottom: 6px solid #a855f7;
        }

        .content h2 i {
            color: #a855f7;
            font-size: 1.1em;
        }

        /* Backup Grid */
        .backup-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 30px;
        }

        .backup-card {
            background: #1a1a1a;
            color: #ffffff;
            padding: 30px;
            border: 6px solid #a855f7;
            transition: all 0.2s;
            cursor: pointer;
            position: relative;
        }

        .backup-card::before {
            content: '';
            position: absolute;
            top: -6px;
            left: -6px;
            right: -6px;
            bottom: -6px;
            background: #a855f7;
            z-index: -1;
            transition: all 0.2s;
        }

        .backup-card:hover {
            transform: translate(-8px, -8px);
            border-color: #ffffff;
        }

        .backup-card:hover::before {
            transform: translate(6px, 6px);
        }

        .backup-card i {
            font-size: 2.5em;
            color: #a855f7;
            margin-bottom: 20px;
            display: block;
        }

        .backup-card h3 {
            font-size: 1.5em;
            margin-bottom: 15px;
            font-weight: 900;
            word-break: break-word;
            color: #ffffff;
            text-transform: uppercase;
            letter-spacing: -0.5px;
        }

        .backup-card p {
            font-size: 0.95em;
            margin-bottom: 20px;
            color: #a855f7;
            font-weight: 700;
            font-family: 'Courier New', monospace;
        }

        .backup-info {
            display: flex;
            flex-direction: column;
            gap: 12px;
            padding-top: 20px;
            border-top: 4px solid #a855f7;
        }

        .backup-info span {
            font-size: 0.9em;
            color: #ffffff;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .backup-info span i {
            color: #a855f7;
        }

        .badge {
            display: inline-block;
            background: #a855f7;
            color: #ffffff;
            padding: 8px 16px;
            border: 3px solid #ffffff;
            margin-top: 15px;
            font-weight: 900;
            text-transform: uppercase;
            font-size: 0.75em;
            letter-spacing: 1px;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 80px 40px;
            background: #1a1a1a;
            border: 6px solid #a855f7;
        }

        .empty-state i {
            font-size: 5em;
            color: #a855f7;
            margin-bottom: 25px;
        }

        .empty-state h3 {
            color: #ffffff;
            margin-bottom: 15px;
            font-size: 2em;
            font-weight: 900;
            text-transform: uppercase;
        }

        .empty-state p {
            color: #a855f7;
            font-size: 1.1em;
            font-weight: 700;
        }

        /* Footer */
        .footer {
            text-align: center;
            padding: 30px;
            border-top: 8px solid #a855f7;
            background: #ffffff;
            color: #000000;
            font-weight: 900;
            font-size: 1.1em;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .header h1 {
                font-size: 2.5em;
                text-shadow: 2px 2px 0 #a855f7;
            }

            .backup-grid {
                grid-template-columns: 1fr;
            }

            .navbar {
                flex-direction: column;
                gap: 20px;
            }

            .navbar-links {
                width: 100%;
            }

            .navbar a {
                width: 100%;
                justify-content: center;
            }

            .content {
                padding: 25px;
            }

            .content h2 {
                font-size: 1.8em;
            }
        }

        /* Animations */
        @keyframes pulse {
            0%, 100% {
                box-shadow: 0 0 20px #a855f7;
            }
            50% {
                box-shadow: 0 0 40px #a855f7;
            }
        }

        .backup-card:focus-visible {
            outline: none;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <div class="navbar">
        <h2><i class="fas fa-database"></i> BACKUP MANAGER</h2>
        <div class="navbar-links">
            <a href="/status"><i class="fas fa-check-circle"></i> STATUS</a>
        </div>
    </div>

    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>📦 DATA BACKUP</h1>
            <p>// KELOLA BACKUP ANDA DENGAN PERCAYA DIRI</p>
        </div>

        <!-- Stats -->
        <div class="stats">
            <div class="stat-card">
                <i class="fas fa-database"></i>
                <h3><%= data ? data.length : 0 %></h3>
                <p>TOTAL BACKUP</p>
            </div>
            <div class="stat-card">
                <i class="fas fa-server"></i>
                <h3>AKTIF</h3>
                <p>SERVER STATUS</p>
            </div>
            <div class="stat-card">
                <i class="fas fa-shield-alt"></i>
                <h3>AMAN</h3>
                <p>DATA TERLINDUNGI</p>
            </div>
        </div>

        <!-- Content -->
        <div class="content">
            <h2><i class="fas fa-list"></i> DAFTAR BACKUP</h2>
            
            <% if (data && data.length > 0) { %>
                <div class="backup-grid">
                    <% data.forEach((item, index) => { %>
                        <div class="backup-card">
                            <i class="fas fa-archive"></i>
                            <h3><%= item.nama || `BACKUP ${index + 1}` %></h3>
                            <p>ID: <code><%= item.id || 'N/A' %></code></p>
                            <div class="backup-info">
                                <span><i class="fas fa-calendar"></i> <%= new Date(item.tanggal_backup).toLocaleDateString('id-ID') || 'N/A' %></span>
                                <span><i class="fas fa-tag"></i> <%= item.channel || 'N/A' %></span>
                            </div>
                            <div class="badge">
                                ✓ TERSIMPAN
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-inbox"></i>
                    <h3>BELUM ADA DATA</h3>
                    <p>// TIDAK ADA BACKUP YANG TERSIMPAN SAAT INI</p>
                </div>
            <% } %>
        </div>

        <!-- Footer -->
        <div class="footer">
            <p><i class="fas fa-bolt"></i> BUILT WITH EXPRESSJS | © 2026</p>
        </div>
    </div>
</body>
</html>

